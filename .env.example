# --- Required ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- State backend: "dynamodb" (prod) or "local" (JSON file, for testing) ---
STATE_BACKEND=local
LOCAL_STATE_PATH=.state/processed_jobs.json
DYNAMODB_TABLE=job_scraper_state
AWS_REGION=eu-central-1
# For local runs against real DynamoDB, use an AWS profile or keys:
# AWS_PROFILE=default

# --- Behaviour ---
# DRY_RUN=true prints Discord payloads instead of posting, and does not write state.
DRY_RUN=false
MATCH_THRESHOLD=65
MAX_JOBS_PER_RUN=40
LLM_MIN_SECONDS_BETWEEN_CALLS=2.0
# Optional: path to a Markdown/text file with your full CV to replace the built-in profile.
# CANDIDATE_PROFILE_FILE=cv.md
# Comma-separated sources: careers (company career pages), nofluffjobs, profession
SOURCES=careers

# --- Career pages (source "careers") ---
# Comma-separated; overrides CAREER_PAGE_URLS in config.py.
# CAREER_PAGE_URLS=https://careers.epam.com/en/jobs/hungary/budapest,https://jobs.sap.com/search/?q=&locationsearch=Budapest
CRAWL4AI_NO_CLOUD_NOTICE=1
